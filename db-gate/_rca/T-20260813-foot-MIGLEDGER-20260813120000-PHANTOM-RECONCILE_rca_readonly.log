=== [2a] v_daily_visits viewdef (is_test filter?) ===
 SELECT (checked_in_at AT TIME ZONE 'Asia/Seoul'::text)::date AS dt,
    clinic_id,
    count(*)::integer AS visit_count,
    sum(
        CASE
            WHEN visit_type = 'new'::text THEN 1
            ELSE 0
        END)::integer AS new_count,
    sum(
        CASE
            WHEN visit_type = 'returning'::text THEN 1
            ELSE 0
        END)::integer AS returning_count,
    sum(
        CASE
            WHEN visit_type = 'experience'::text THEN 1
            ELSE 0
        END)::integer AS experience_count
   FROM check_ins ci
  WHERE status <> 'cancelled'::text AND checked_in_at IS NOT NULL
  GROUP BY ((checked_in_at AT TIME ZONE 'Asia/Seoul'::text)::date), clinic_id;
  -> contains is_test: false

=== [2b] v_daily_visit_rate viewdef (is_test filter?) ===
 WITH res AS (
         SELECT reservations.reservation_date AS dt,
            reservations.clinic_id,
            count(*)::integer AS total_reservations
           FROM reservations
          WHERE reservations.status <> 'cancelled'::text
          GROUP BY reservations.reservation_date, reservations.clinic_id
        ), ck AS (
         SELECT (check_ins.checked_in_at AT TIME ZONE 'Asia/Seoul'::text)::date AS dt,
            check_ins.clinic_id,
            count(*)::integer AS checkin_count
           FROM check_ins
          WHERE check_ins.status <> 'cancelled'::text AND check_ins.checked_in_at IS NOT NULL
          GROUP BY ((check_ins.checked_in_at AT TIME ZONE 'Asia/Seoul'::text)::date), check_ins.clinic_id
        )
 SELECT COALESCE(r.dt, c.dt) AS dt,
    COALESCE(r.clinic_id, c.clinic_id) AS clinic_id,
    COALESCE(r.total_reservations, 0) AS total_reservations,
    COALESCE(c.checkin_count, 0) AS checkin_count,
        CASE
            WHEN COALESCE(r.total_reservations, 0) > 0 THEN round(COALESCE(c.checkin_count, 0)::numeric / r.total_reservations::numeric * 100::numeric, 1)
            ELSE 0::numeric
        END AS visit_rate_pct
   FROM res r
     FULL JOIN ck c ON
  -> contains is_test: false

