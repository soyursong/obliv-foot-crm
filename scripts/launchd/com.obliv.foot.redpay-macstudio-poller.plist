-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.obliv.foot.redpay-macstudio-poller</string>

    <!--
      T-20260729-foot-REDPAY-POLLER-DEDICATED-CHECKOUT — stale-hazard 근본대책.
      WorkingDirectory = 폴러 전용 main-고정 checkout(피처 체크아웃과 물리 분리). dev 가 어떤 브랜치를
      체크아웃해도 폴러 실행체는 origin/main 불변. 매 사이클 진입 시 best-effort FF(fetch+reset --hard
      origin/main) 로 최신 main 을 self-heal — fetch 실패(네트워크 블립)여도 `;` 로 node 는 항상 실행되며
      전용 checkout 의 정지상태가 곧 origin/main 이므로 stale 불가(§AC2). registry SSOT·env(~/.env.redpay-foot)
      ·state 파일은 모두 절대경로(homedir)라 WorkingDirectory 무관하게 동일 해석(§AC4).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/domas/GitHub/obliv-foot-crm-redpay-poller &amp;&amp; { git fetch origin main --quiet &amp;&amp; git reset --hard --quiet origin/main ; } ; node scripts/redpay_macstudio_poller.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/domas/GitHub/obliv-foot-crm-redpay-poller</string>

    <!-- 5분(300초) 주기 증분 폴 -->
    <key>StartInterval</key><integer>300</integer>
    <key>RunAtLoad</key><true/>

    <!-- SPOF 완화(AC-7): 크래시 시 자동 재기동. 정상 종료(exit 0)는 다음 StartInterval 대기. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key><false/>
    </dict>
    <!-- 재기동 폭주 방지: 실패 후 최소 60초 간격 -->
    <key>ThrottleInterval</key><integer>60</integer>

    <key>StandardOutPath</key><string>/Users/domas/logs/redpay_macstudio_poller.out</string>
    <key>StandardErrorPath</key><string>/Users/domas/logs/redpay_macstudio_poller.err</string>
</dict>
</plist>
