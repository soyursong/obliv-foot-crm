
===== C1_authz_helper_functions =====
[
 {
  "fn": "current_user_is_admin_or_manager",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.current_user_is_admin_or_manager() RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public' AS $function$ SELECT COALESCE(role IN ('admin','manager'), FALSE) FROM user_profiles WHERE id = auth.uid() $function$"
 },
 {
  "fn": "is_admin",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.is_admin() RETURNS boolean LANGUAGE sql STABLE AS $function$ SELECT UPPER(COALESCE(public.current_user_role(), '')) = 'ADMIN'; $function$"
 },
 {
  "fn": "is_manager_or_above",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.is_manager_or_above() RETURNS boolean LANGUAGE sql STABLE AS $function$ SELECT public.role_level(public.current_user_role()) >= 1; $function$"
 },
 {
  "fn": "can_assign_rooms",
  "has_gate": true,
  "def": "CREATE OR REPLACE FUNCTION public.can_assign_rooms() RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public' AS $function$ SELECT is_approved_user() AND current_user_role() IN ( 'admin','manager','director','consultant','coordinator','therapist','part_lead','staff' ); $function$"
 },
 {
  "fn": "is_admin_or_manager",
