
===== I1_helper_defs =====
[
 {
  "fn": "current_user_is_admin_or_manager",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.current_user_is_admin_or_manager()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT COALESCE(role IN ('admin','manager'), FALSE)\n  FROM user_profiles WHERE id = auth.uid()\n$function$\n"
 },
 {
  "fn": "current_user_role",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.current_user_role()\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT role::text FROM user_profiles WHERE id = auth.uid()\n$function$\n"
 },
 {
  "fn": "current_user_staff_id",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.current_user_staff_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT id FROM staff WHERE user_id = auth.uid() LIMIT 1\n$function$\n"
 },
 {
  "fn": "is_admin",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\n  SELECT UPPER(COALESCE(public.current_user_role(), '')) = 'ADMIN';\n$function$\n"
 },
 {
  "fn": "is_admin_or_manager",
  "has_gate": true,
  "def": "CREATE OR REPLACE FUNCTION public.is_admin_or_manager()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT is_approved_user()\n     AND current_user_role() IN ('admin','manager','director');\n$function$\n"
 },
 {
  "fn": "is_approved_user",
  "has_gate": true,
  "def": "CREATE OR REPLACE FUNCTION public.is_approved_user()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT EXISTS (\n    SELECT 1 FROM user_profiles\n    WHERE id = auth.uid()\n      AND COALESCE(approved, false) = true\n      AND COALESCE(active, true) = true\n  );\n$function$\n"
 },
 {
  "fn": "is_manager_or_above",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.is_manager_or_above()\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\n  SELECT public.role_level(public.current_user_role()) >= 1;\n$function$\n"
 },
 {
  "fn": "role_level",
  "has_gate": false,
  "def": "CREATE OR REPLACE FUNCTION public.role_level(role_text text)\n RETURNS integer\n LANGUAGE sql\n IMMUTABLE\nAS $function$\n  SELECT CASE UPPER(COALESCE(role_text, ''))\n    WHEN 'AGENT' THEN 0\n    WHEN 'PART_LEADER' THEN 1\n    WHEN 'TEAM_LEADER' THEN 2\n    WHEN 'MANAGER' THEN 2\n    WHEN 'ADMIN' THEN 3\n    ELSE -1\n  END;\n$function$\n"
 }
]

